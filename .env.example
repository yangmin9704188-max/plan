# GitHub fine-grained token (read-only). Needed for private repositories.
# Permissions: Contents: Read-only (the plan repo) + Pull requests: Read-only (product repos).
GITHUB_TOKEN=

# Where GPT writes feature files.
FEATURES_REPO=yangmin9704188-max/plan
FEATURES_DIR=features
FEATURES_REF=main

# Optional: read feature files from a local folder instead of GitHub (testing).
# FEATURES_LOCAL_DIR=examples/features

# Local-only app; do not expose publicly without adding authentication.
PORT=4400
